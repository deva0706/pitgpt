# PitGPT environment variables (copy to .env and edit as needed).
# These are read by src/pitgpt/config/settings.py at import time.

# Override the base model (default: HuggingFaceTB/SmolLM2-360M-Instruct)
# PITGPT_BASE_MODEL=HuggingFaceTB/SmolLM2-360M-Instruct

# Force fully-offline mode once the model is cached (skip network calls):
# HF_HUB_OFFLINE=1
